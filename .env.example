# Required only to make model requests. Never commit the real .env file.
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible DeepSeek endpoint override.
DEEPSEEK_BASE_URL=

# Docker publishes only this loopback port.
DSH_PORT=3080

# Host directory mounted as the Harness working directory.
# On Windows, use an absolute path only if you do not want the repository root.
DSH_WORKSPACE=.
